{
  "openapi": "3.0.0",
  "info": {
    "title": "Voice Proofreader API",
    "description": "AI writing detection and proofreading. Detects AI-generated writing patterns and provides cleaned text with reduced AI signals.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://voicekeeper-api-922749444863.us-central1.run.app"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Health check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "version": {
                      "type": "string",
                      "example": "0.1.0"
                    }
                  },
                  "required": ["status", "version"]
                }
              }
            }
          }
        }
      }
    },
    "/v1/detect": {
      "post": {
        "summary": "Detect AI writing patterns",
        "description": "Analyzes text for AI-generated writing patterns across 6 categories: hedging, transitions, fluff, politeness, qualifiers, and structure.",
        "operationId": "detectPatterns",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "The text to analyze for AI writing patterns. Minimum 10 words for meaningful analysis."
                  }
                },
                "required": ["text"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Analysis complete",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "aiScore": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "AI probability score. 0=human, 100=AI"
                    },
                    "verdict": {
                      "type": "string",
                      "enum": ["human", "mixed", "ai"],
                      "description": "Classification verdict based on AI score"
                    },
                    "patterns": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "pattern": {
                            "type": "string",
                            "description": "Pattern name"
                          },
                          "category": {
                            "type": "string",
                            "enum": ["hedging", "transitions", "fluff", "politeness", "qualifiers", "structure"],
                            "description": "Pattern category"
                          },
                          "matches": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Matched text fragments"
                          },
                          "severity": {
                            "type": "string",
                            "enum": ["low", "medium", "high"],
                            "description": "Pattern severity level"
                          }
                        },
                        "required": ["pattern", "category", "matches", "severity"]
                      }
                    },
                    "flaggedSentences": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Unique matched text fragments"
                    },
                    "summary": {
                      "type": "string",
                      "description": "Human-readable analysis summary"
                    }
                  },
                  "required": ["aiScore", "verdict", "patterns", "flaggedSentences", "summary"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/v1/proofread": {
      "post": {
        "summary": "Remove AI writing patterns from text",
        "description": "Analyzes text for AI patterns, applies rule-based cleanup (replacing fluff words with simpler alternatives, removing hedging and politeness phrases), and returns cleaned text with before/after AI scores.",
        "operationId": "proofreadText",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "The text to proofread and clean of AI patterns"
                  },
                  "instructions": {
                    "type": "string",
                    "description": "Additional proofreading instructions (reserved for future use)"
                  }
                },
                "required": ["text"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Proofreading complete",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "description": "Cleaned text with AI patterns reduced"
                    },
                    "aiScoreBefore": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "AI score before proofreading"
                    },
                    "aiScoreAfter": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "AI score after proofreading"
                    },
                    "patternsRemoved": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "List of patterns that were removed or replaced"
                    }
                  },
                  "required": ["result", "aiScoreBefore", "aiScoreAfter", "patternsRemoved"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    }
  }
}
